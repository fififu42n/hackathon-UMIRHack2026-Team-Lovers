{
  "_comment": "Конфиг типов документов. Новый тип добавляется описанием полей здесь, без изменения кода. kind: text | date | mark. rule: пункт Положения, который требует это поле. patterns: regex (нижний регистр, ё->е) для вопросов без кавычек.",
  "study_certificate": {
    "title": "справка об обучении",
    "fields": {
      "student_name":    {"label": "ФИО студента",                 "kind": "text", "rule": "3.1", "patterns": ["фио студента", "фамили", "как зовут", "имя студента"]},
      "university":      {"label": "Название вуза",                "kind": "text", "rule": "3.1", "patterns": ["название вуза", "наименование вуза", "какой вуз", "какой университет", "в каком вузе", "в каком университете"]},
      "program":         {"label": "Направление подготовки",       "kind": "text", "rule": "3.1", "patterns": ["направлени", "специальност"]},
      "study_form":      {"label": "Форма обучения",               "kind": "text", "rule": "3.1", "patterns": ["форма обучения", "форме обучения", "очная или", "очно"]},
      "study_start":     {"label": "Начало периода обучения",      "kind": "date", "rule": "3.1", "patterns": ["начал\\w* (периода )?обучения", "начина\\w* обучени", "с какого числа обучается"]},
      "study_end":       {"label": "Окончание периода обучения",   "kind": "date", "rule": "3.1", "patterns": ["оконч\\w* (периода )?обучения", "(закан|законч)\\w* обучени", "до какого числа обучается"]},
      "document_number": {"label": "Номер справки",                "kind": "text", "rule": "3.1", "patterns": ["номер справки", "номер документа", "какой номер"]},
      "issue_date":      {"label": "Дата выдачи",                  "kind": "date", "rule": "3.1", "patterns": ["дата выдачи", "когда выдан", "дата справки"]},
      "signature_present": {"label": "Подпись сотрудника",         "kind": "mark", "rule": "3.2", "patterns": ["подпис"]},
      "seal_present":      {"label": "Печать вуза",                "kind": "mark", "rule": "3.3", "patterns": ["печат"]}
    }
  },
  "academic_leave_application": {
    "title": "заявление на академический отпуск",
    "fields": {
      "student_name":    {"label": "ФИО студента",                 "kind": "text", "rule": "4.1", "patterns": ["фио студента", "фамили", "как зовут", "имя студента"]},
      "group":           {"label": "Учебная группа",               "kind": "text", "rule": "4.1", "patterns": ["групп"]},
      "course":          {"label": "Курс",                         "kind": "text", "rule": "4.1", "patterns": ["\\bкурс"]},
      "leave_reason":    {"label": "Причина отпуска",              "kind": "text", "rule": "4.1", "patterns": ["причин", "почему берет", "по какой причине"]},
      "leave_start":     {"label": "Дата начала отпуска",          "kind": "date", "rule": "4.1", "patterns": ["начал\\w* отпуска", "отпуск\\w* начина", "начина\\w* отпуск", "с какого числа отпуск"]},
      "leave_end":       {"label": "Дата окончания отпуска",       "kind": "date", "rule": "4.1", "patterns": ["оконч\\w* отпуска", "отпуск\\w* (заканчива|законч)", "(закан|законч)\\w* отпуск", "до какого числа отпуск"]},
      "application_date":{"label": "Дата заявления",               "kind": "date", "rule": "4.1", "patterns": ["дата заявления", "когда подано", "когда написано"]},
      "signature_present": {"label": "Подпись студента",           "kind": "mark", "rule": "4.2", "patterns": ["подпис"]}
    }
  },
  "internship_certificate": {
    "title": "справка о практике",
    "fields": {
      "student_name":    {"label": "ФИО студента",                 "kind": "text", "rule": "5.1", "patterns": ["фио студента", "фамили", "как зовут", "имя студента"]},
      "organization":    {"label": "Название организации",         "kind": "text", "rule": "5.1", "patterns": ["название организации", "организаци", "где проходил", "где проходила", "место практики"]},
      "internship_start":{"label": "Дата начала практики",         "kind": "date", "rule": "5.1", "patterns": ["начал\\w* практики", "практик\\w* начина", "начина\\w* практик", "с какого числа практик"]},
      "internship_end":  {"label": "Дата окончания практики",      "kind": "date", "rule": "5.1", "patterns": ["оконч\\w* практики", "практик\\w* (заканчива|законч)", "(закан|законч)\\w* практик", "до какого числа практик"]},
      "supervisor_name": {"label": "ФИО руководителя практики",    "kind": "text", "rule": "5.1", "patterns": ["фио руководител", "руководител"]},
      "grade":           {"label": "Оценка",                       "kind": "text", "rule": "5.1", "patterns": ["оценк", "отметк", "балл"]},
      "document_number": {"label": "Номер справки",                "kind": "text", "rule": "5.1", "patterns": ["номер справки", "номер документа", "какой номер"]},
      "issue_date":      {"label": "Дата выдачи",                  "kind": "date", "rule": "5.1", "patterns": ["дата выдачи", "когда выдан", "дата справки"]},
      "signature_present": {"label": "Подпись руководителя",       "kind": "mark", "rule": "5.2", "patterns": ["подпис"]},
      "seal_present":      {"label": "Печать организации",         "kind": "mark", "rule": "5.3", "patterns": ["печат"]}
    }
  },
  "_not_established_rules": ["3.5", "4.4", "5.5"]
}
